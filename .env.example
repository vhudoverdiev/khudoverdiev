FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=
# Use ADMIN_PASSWORD_HASH in production. Generate it with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=
REQUIRE_ADMIN_PASSWORD_HASH=1
FLASK_COOKIE_SECURE=1
FORCE_HTTPS=1
SITE_DB_PATH=/var/lib/khudoverdiev/site.db
# Optional: comma-separated IPs/CIDRs allowed to open /st, /sk, /admin.
ADMIN_IP_ALLOWLIST=
# Optional: comma-separated reverse proxy IPs/CIDRs trusted for X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
